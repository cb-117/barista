// Cloudflare Worker for the website at https://baristatime.app.
// Deploys from GitHub Actions (.github/workflows/pages.yml) on every push to main that
// touches site/ or worker/. Deploy by hand with: npx wrangler deploy
{
  "name": "barista-site",
  "account_id": "d7c4f3929d6e494559b5034151619b6f",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // The Worker sees every request first: it redirects www and proxies /ingest to PostHog.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "baristatime.app", "custom_domain": true },
    { "pattern": "www.baristatime.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": true }
}
